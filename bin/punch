#!/usr/bin/env bash
# ./bin/punch — trampoline to the interactive k6 workflow picker.
#
# Real implementation lives in the vendor/punch submodule (k6-ts-docker's
# Punch orchestrator); this repo only points it at its own workflows
# directory. Install vendor/punch/requirements.txt before first use.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

exec "$REPO_ROOT/vendor/punch/bin/punch" menu "$REPO_ROOT/tests/performance/k6/workflows" "$@"
