#!/usr/bin/env bash
# ./bin/punch — trampoline to the interactive k6 workflow picker.
#
# Real implementation lives in scripts/pg/perf_menu.py.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PYTHON="${PYTHON:-python3}"
if ! command -v "$PYTHON" >/dev/null 2>&1; then
  echo "ERROR: python3 not found. Install Python 3.9+ or set PYTHON=/path/to/python." >&2
  exit 1
fi

exec "$PYTHON" "$REPO_ROOT/scripts/pg/perf_menu.py" "$@"
