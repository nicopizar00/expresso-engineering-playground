generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               Int      @id @default(autoincrement())
  productId        String   @unique
  sku              String   @unique
  name             String
  description      String
  category         String
  priceAmountMinor Int
  priceCurrency    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Order {
  id               Int         @id @default(autoincrement())
  orderId          String      @unique
  // Caller-supplied idempotency key. NULL when the caller did not provide one
  // (legacy or fire-and-forget). The unique constraint is the final safety net
  // against concurrent retries — Postgres allows multiple NULLs.
  clientRequestId  String?     @unique
  // Anonymous checkout (CUP-002): no name is collected or required. Nullable
  // rather than removed so historical orders keep their stored value.
  customerName     String?
  // Anonymous owner: the `sid` cookie of the browser that placed the order.
  // NULL for seed and pre-session orders, which only appear in GET /orders.
  sessionId        String?
  // Who the order is for (login feature). Plain normalized strings, no FK:
  // an order may target a username/email that registers later. At most one
  // is set; both null = guest.
  ownerUsername    String?
  ownerEmail       String?
  totalAmountMinor Int
  totalCurrency    String
  placedAt         DateTime
  updatedAt        DateTime    @updatedAt
  lines            OrderLine[]

  @@index([sessionId])
  // Composite so GET /me/hot-status (owner + placedAt range) and
  // GET /me/orders (owner, newest first) are index scans.
  @@index([ownerUsername, placedAt])
  @@index([ownerEmail, placedAt])
}

model OrderLine {
  id              Int    @id @default(autoincrement())
  orderId         String
  order           Order  @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  productId       String
  name            String
  quantity        Int
  unitAmountMinor Int
  unitCurrency    String
  lineAmountMinor Int
  lineCurrency    String
}

// Parametric geometry config for a domain category (e.g. "drink").
// Mirrors the shape of ESPRESSO_CFG in apps/visualizer-3d/public/scene.js
// so the visualizer can tune proportions without a redeploy.
model AssetConfig {
  id        Int      @id @default(autoincrement())
  category  String   @unique
  params    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reference to a pre-baked 3D asset (GLB/glTF) produced by the offline
// Blender pipeline (scripts/blender/export_glb.py). The visualizer prefers
// the primary model when present and falls back to AssetConfig + procedural
// geometry when not. Multiple variants per category support future LODs.
model AssetModel {
  id          Int      @id @default(autoincrement())
  category    String
  variant     String   @default("default")
  assetUrl    String
  assetFormat String   @default("glb")
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, variant])
  @@index([category, isPrimary])
}

// Registered user. username and email are stored normalized (trim +
// lowercase) — see apps/bff/src/core/auth/identity.ts.
model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  email        String        @unique
  // "scrypt$N$r$p$<salt b64>$<hash b64>" — see core/auth/password.ts.
  passwordHash String
  createdAt    DateTime      @default(now())
  sessions     AuthSession[]
}

// Signed-in browser. Only sha256(token) is stored; the raw token lives in
// the `auth` cookie.
model AuthSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}
